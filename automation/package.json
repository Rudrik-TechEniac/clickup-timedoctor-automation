{
  "name": "clickup-timedoctor-automation",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-driven automation connecting Claude, ClickUp, and Time Doctor (Windows first; Mac to follow).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcp:stdio": "node --loader ts-node/esm src/mcpStdioEntry.ts",
    "server": "node --loader ts-node/esm src/httpEntry.ts",
    "dev:server": "node --loader ts-node/esm --watch src/httpEntry.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
