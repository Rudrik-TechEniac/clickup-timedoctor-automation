# ClickUp
# Get this from: ClickUp -> click your avatar (bottom-left) -> Settings -> Apps -> API Token -> Generate
CLICKUP_API_TOKEN=pk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Find via GET https://api.clickup.com/api/v2/team once you have the token above
CLICKUP_TEAM_ID=your_clickup_team_id
# Optional: restrict "next ticket" search to a specific ClickUp user id (defaults to the token owner)
CLICKUP_ASSIGNEE_USER_ID=

# ClickUp webhook signing secret (returned when you register the webhook - see README)
CLICKUP_WEBHOOK_SECRET=

# HTTP server
PORT=3100

# Windows Time Doctor automation
# Path to the PowerShell scripts (scripts/windows) - absolute path recommended
TD_SCRIPTS_DIR=C:\Users\teche\OneDrive\Desktop\ClickUp\automation\scripts\windows
# Set to "true" to skip actually clicking (useful for testing ClickUp-only flows)
TD_AUTOMATION_DISABLED=false

# ClickUp status names used by the sync mapping - these are just common defaults, NOT
# guaranteed to exist in your workspace. Check your real statuses first: call
# GET https://api.clickup.com/api/v2/task/<any_task_id>?include_closed=true with your
# token and look at the task's list's statuses, or just check the status dropdown on
# a real task in the ClickUp UI. Every workspace customizes these differently.
STATUS_IN_PROGRESS=in progress
STATUS_IN_REVIEW=in review
STATUS_TODO=to do
